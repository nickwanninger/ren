//   Name          , Resource Info                    , Top Level Allowed?, VkDescriptorType
TYPE(UniformBuffer , SRT_RESOURCE|SRT_BUFFER          , false             , VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER)
TYPE(StorageBuffer , SRT_RESOURCE|SRT_BUFFER|SRT_WRITE, false             , VK_DESCRIPTOR_TYPE_STORAGE_BUFFER)
TYPE(Texture       , SRT_RESOURCE                     , false             , VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER)
TYPE(Sampler       , SRT_RESOURCE                     , false             , VK_DESCRIPTOR_TYPE_SAMPLER)
TYPE(Image         , SRT_RESOURCE                     , false             , VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE)
TYPE(StorageImage  , SRT_RESOURCE|SRT_WRITE           , false             , VK_DESCRIPTOR_TYPE_STORAGE_IMAGE)
TYPE(ResourceArray , SRT_RESOURCE                     , true              , -1)
TYPE(PushConstant  , SRT_BUFFER                       , true              , -1)
TYPE(ParameterBlock, 0                                , true              , VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER)
TYPE(LogicalGroup  , 0                                , true              , -1)
TYPE(EntryPoint    , 0                                , true              , -1)
TYPE(Struct        , 0                                , false             , -1)
TYPE(Array         , 0                                , false             , -1)
TYPE(Scalar        , 0                                , false             , -1)
TYPE(Pointer       , 0                                , false             , -1)
