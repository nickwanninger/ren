//   Name          , Resource Info                    , Top Level Allowed?
TYPE(UniformBuffer , SRT_RESOURCE|SRT_BUFFER          , false)
TYPE(StorageBuffer , SRT_RESOURCE|SRT_BUFFER|SRT_WRITE, false)
TYPE(Texture       , SRT_RESOURCE                     , false)
TYPE(Sampler       , SRT_RESOURCE                     , false)
TYPE(Image         , SRT_RESOURCE                     , false)
TYPE(StorageImage  , SRT_RESOURCE|SRT_WRITE           , false)
TYPE(ResourceArray , SRT_RESOURCE                     , true)
TYPE(PushConstant  , SRT_BUFFER                       , true)
TYPE(ParameterBlock, 0                                , true)
TYPE(LogicalGroup  , 0                                , true)
TYPE(EntryPoint    , 0                                , true)
TYPE(Struct        , 0                                , false)
TYPE(Array         , 0                                , false)
TYPE(Scalar        , 0                                , false)
